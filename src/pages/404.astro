---
import Base from '../layouts/Base.astro';
import Buddy from '../components/Buddy.astro';
import { t, path } from '../i18n/site';
// One 404 for the whole site (GitHub Pages serves 404.html), in both languages.
---
<Base lang="en" page="" title="Page not found · Hinto" description="This page doesn't exist." noindex>
  <section class="container nf">
    <Buddy name="pochi" pose="sleep" size={120} />
    <h1>{t.en.notFoundTitle}</h1>
    <p lang="ja" class="lead">{t.ja.notFoundTitle}</p>
    <p><a href={path('en', '')}>{t.en.notFoundLink}</a> · <a lang="ja" href={path('ja', '')}>{t.ja.notFoundLink}</a></p>
  </section>
</Base>
<style>
  .nf { text-align: center; padding: var(--section-y) var(--gutter); }
  h1 { font-size: var(--fs-h2); font-weight: 800; margin: 16px 0 8px; }
</style>
